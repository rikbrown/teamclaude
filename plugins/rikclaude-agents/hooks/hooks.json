{
  "description": "Prints the agent routing policy and any local overrides into every session.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/routing.md\" \"$HOME/.claude/rikclaude-agents.local.md\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Loading agent routing policy"
          }
        ]
      }
    ]
  }
}
